        <SolidColorBrush x:Key="RedBrush"     Color="#FF3B5C"/>
        <SolidColorBrush x:Key="YellowBrush"  Color="#FFC14D"/>
        <SolidColorBrush x:Key="TextBrush"    Color="#DDE6F5"/>
        <SolidColorBrush x:Key="MutedBrush"   Color="#5A6A85"/>
        <SolidColorBrush x:Key="Muted2Brush"  Color="#3D4F6A"/>
