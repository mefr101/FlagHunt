<Application x:Class="FlagHunt.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <SolidColorBrush x:Key="BgBrush"      Color="#0B0D11"/>
        <SolidColorBrush x:Key="PanelBrush"   Color="#12151C"/>
        <SolidColorBrush x:Key="SurfaceBrush" Color="#181D27"/>
        <SolidColorBrush x:Key="Srf2Brush"    Color="#1E2535"/>
